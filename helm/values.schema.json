{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [],

  "$comment": "additionalProperties is false on every object the chart defines, so a mistyped key fails the install by name instead of being silently discarded. The free-form objects below (resources, security contexts, nodeSelector, affinity) stay open on purpose: their contents are Kubernetes' to validate, not this chart's.",
  "additionalProperties": false,

  "properties": {
    "stackradar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiUrl":                     { "type": "string", "format": "uri" },
        "clusterId":                  { "type": "string" },
        "apiKey":                     { "type": "string" },
        "existingSecret":             { "type": "string" },
        "existingSecretKeyApiKey":    { "type": "string" },
        "existingSecretKeyClusterId": { "type": "string" }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excludeNamespaces":       { "type": "string" },
        "includeNamespaces":       { "type": "string" },
        "syftTimeoutMs":           { "type": "string", "pattern": "^[0-9]+$" },
        "skipExistingDigests":     { "type": "string", "enum": ["true", "false"] },
        "resolveImagePullSecrets": { "type": "string", "enum": ["true", "false"] },
        "imagePullSecretNames":    { "type": "array", "items": { "type": "string" } }
      }
    },
    "watcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":         { "type": "boolean" },
        "sweepIntervalMs": { "type": "string", "pattern": "^[0-9]+$" },
        "concurrentScans": { "type": "string", "pattern": "^[0-9]+$" },
        "resources":       { "type": "object" }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,

      "$comment": "A pattern rather than \"format\": \"uri\". Two reasons: the empty default is not a valid URI and would fail every install that leaves these unset, and `proxy.corp:8080` — the mistake people actually make — *is* a valid URI, so format would accept the one value that does not work. The pattern accepts empty or a scheme-qualified URL and nothing else.",

      "properties": {
        "httpProxy":  { "type": "string", "pattern": "^(https?://.+)?$" },
        "httpsProxy": { "type": "string", "pattern": "^(https?://.+)?$" },
        "noProxy":    { "type": "string" }
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,

      "$comment": "No minLength on `key`: an empty key with a bundle configured is caught in deployment.yaml, which can say what to do about it. The mutual exclusion of configMapName and secretName is a template guard for the same reason — JSON Schema can express it, but only as a oneOf whose failure message names neither key.",

      "properties": {
        "configMapName": { "type": "string" },
        "secretName":    { "type": "string" },
        "key":           { "type": "string" }
      }
    },
    "dockerConfigSecret": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "digest":     { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets":   { "type": "array" },

    "podLabels": {
      "type": "object",
      "$comment": "Typed as a map of strings rather than left open like nodeSelector: Kubernetes rejects a non-string label value, and `--set podLabels.foo=1` produces exactly that. Caught here, the error names the key instead of arriving from the API server at install time.",
      "additionalProperties": { "type": "string" }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext":    { "type": "object" },
    "nodeSelector":       { "type": "object" },
    "tolerations":        { "type": "array" },
    "affinity":           { "type": "object" },
    "priorityClassName":  { "type": "string" },
    "nameOverride":       { "type": "string" },
    "fullnameOverride":   { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create":      { "type": "boolean" },
        "name":        { "type": "string" },
        "annotations": {
          "type": "object",
          "$comment": "Same reasoning as podLabels: annotation values are strings to Kubernetes, so a role ARN typo'd into a number fails here by name.",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}

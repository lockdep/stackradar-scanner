{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  // Everything under src/, tests included, is typechecked. Emit is narrower —
  // see tsconfig.build.json.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
